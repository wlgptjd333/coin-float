rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user reaches only their own two settings documents; everything else stays denied.
    match /users/{uid}/sync/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && doc in ['chart', 'app']
        && request.resource.data.keys().hasOnly(['json', 'hash', 'at', 'from'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000;
    }
  }
}
