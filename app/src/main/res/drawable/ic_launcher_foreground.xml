<?xml version="1.0" encoding="utf-8"?>
<!-- A floating price window (the app's overlay) with a rising line; the soft shadow below makes it float. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- shadow -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.18"
        android:pathData="M32,80 a22,3 0 1,0 44,0 a22,3 0 1,0 -44,0z" />
    <!-- window -->
    <path
        android:fillColor="#0C1219"
        android:fillAlpha="0.95"
        android:pathData="M39,31 H69 A11,11 0 0,1 80,42 V64 A11,11 0 0,1 69,75 H39 A11,11 0 0,1 28,64 V42 A11,11 0 0,1 39,31 Z" />
    <!-- title bar sheen -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.04"
        android:pathData="M39,31.6 H69 A10.4,10.4 0 0,1 79.4,42 V44 H28.6 V42 A10.4,10.4 0 0,1 39,31.6 Z" />
    <!-- live dot + title -->
    <path
        android:fillColor="#3CF0B4"
        android:pathData="M35,38.5 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4"
        android:pathData="M44.3,37.2 h10.4 a1.3,1.3 0 0,1 0,2.6 h-10.4 a1.3,1.3 0 0,1 0,-2.6z" />
    <!-- rising line -->
    <path
        android:pathData="M35.5,66 L45,58.5 L53,62.5 L68.5,49.5"
        android:strokeColor="#3CF0B4"
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- glowing last price -->
    <path
        android:fillColor="#3CF0B4"
        android:fillAlpha="0.22"
        android:pathData="M62,49.5 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M65.1,49.5 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0z" />
</vector>
